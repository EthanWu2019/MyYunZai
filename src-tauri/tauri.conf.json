{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YunZaiConsole",
  "version": "0.4.0",
  "identifier": "com.ethanwu.yunzai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YunZai Console",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "YunZai Console"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/NapCat.Shell.zip": "resources/NapCat.Shell.zip"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "TRSS Yunzai desktop console",
    "longDescription": "Unified TRSS Yunzai + NapCat + Redis + WebUI launcher."
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "海绵酱控制台",
  "version": "0.1.0",
  "identifier": "com.ethanwu.yunzai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "海绵酱控制台",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "海绵酱控制台 · YunZai"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "TRSS Yunzai 桌面控制台",
    "longDescription": "把 HYZL 启动器 + Redis + Yunzai 后端 + NapCat 协议端 + WebUI 扫码整合到一个桌面 App,一键启停,实时状态,日志面板,内嵌扫码。"
  }
}
